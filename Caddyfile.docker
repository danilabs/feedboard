# Feedboard production Caddyfile
#
# Set DOMAIN=yourdomain.com for automatic Let's Encrypt HTTPS

{$DOMAIN} {

	# Auth proxy
	handle /auth/* {
		reverse_proxy authproxy:8091
	}
	handle /api/* {
		reverse_proxy authproxy:8091
	}

	# MediaMTX API (host network)
	handle /v3/* {
		reverse_proxy {$MTX_HOST}:9997
	}

	# Thumbnailer WebSocket
	@thumbs_ws {
		path /thumbs/ws
		header Connection *Upgrade*
	}
	handle @thumbs_ws {
		uri strip_prefix /thumbs
		reverse_proxy thumbnailer:8090
	}

	# Thumbnailer API
	handle_path /thumbs/* {
		reverse_proxy thumbnailer:8090
	}

	# MediaMTX WebRTC - WHIP endpoints (publish)
	@whip path */whip
	handle @whip {
		reverse_proxy {$MTX_HOST}:8889
	}

	# MediaMTX WebRTC - WHEP endpoints (playback)
	@whep path */whep
	handle @whep {
		reverse_proxy {$MTX_HOST}:8889
	}

	# MediaMTX HLS and recordings - validate cookie/token, inject JWT
	@hls path_regexp hls ^/.+\.(m3u8|ts|mp4)$
	handle @hls {
		header Access-Control-Allow-Origin *

		# Validate auth (cookie or stream token) and get JWT
		forward_auth authproxy:8091 {
			uri /auth/token?{http.request.uri.query}
			copy_headers X-Auth-Token
		}

		# Pass token to MediaMTX via Authorization header
		reverse_proxy {$MTX_HOST}:8888 {
			header_up Authorization "Bearer {http.request.header.X-Auth-Token}"
		}
	}

	# Static examples (no SPA fallback)
	handle /examples/* {
		root * /srv
		file_server
	}

	# Static files with SPA fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
