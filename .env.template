# Feedboard Environment Configuration
# Copy to .env and customize: cp .env.template .env
#
# Generate secure values: openssl rand -hex 32

# =============================================================================
# Production Deployment
# =============================================================================

# Domain for HTTPS
# - Real domain (example.com) → automatic Let's Encrypt certificate
# - Port only (:443) → self-signed certificate (local/dev)
# - Port only (:80) → plain HTTP, no certificate at all (e.g. accessing
#   the server by LAN IP only, with no hostname to issue a cert for)
# - Empty → defaults to :443 (self-signed)
# DOMAIN=example.com

# =============================================================================
# Authentication
# =============================================================================

# Initial admin password (only used on first run when no users exist)
ADMIN_PASSWORD=admin

# JWT signing secret (IMPORTANT: users are logged out if this changes)
JWT_SECRET=dev-jwt-secret-change-in-prod

# =============================================================================
# Internal Service Tokens
# =============================================================================

# Service token for thumbnailer to access MediaMTX streams
THUMBNAILER_TOKEN=dev-thumbnailer-token-change-in-prod

# Service token for test stream publishers (runOnInit commands in mediamtx.yml)
INTERNAL_PUBLISH_TOKEN=dev-internal-publish-token

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================

# Allowed origins for cross-origin requests
# Leave empty if all requests come from same origin (e.g., behind Caddy)
# Set if: embedding on other domains, API on different subdomain, or dev without Caddy
# Supports: * (all), *.example.com (suffix), exact URLs, comma-separated
# CORS_ORIGINS=http://localhost:5173
# CORS_ORIGINS=https://app.example.com
# CORS_ORIGINS=*.mydomain.com,https://embed.example.com
